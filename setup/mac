#!/usr/bin/env bash

# init
xcode-select --install
if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"
fi

brew install git

# dotfiles repo
rm "$HOME/.zshrc" # remove default zshrc from new macos version
git clone --bare https://github.com/liaden/dotfiles "$HOME/.cfg"
alias config='/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME'
config checkout

# zsh plugin manager
git clone https://github.com/jandamm/zgenom.git "${HOME}/.zgenom"

brew install zsh bash pdsh gpg
brew install direnv
brew install tmux reattach-to-user-namespace
brew install hub tig gh
brew install fzf
brew install chruby ruby-install
brew install neovim
brew install ctop htop glances
brew install the_silver_searcher
brew install xz
brew install wget jq lynx
brew install gnu-tar gnu-sed
brew install shellcheck yamllint kubeval
brew install fd
brew install asdf ruby-build
brew install openssl libyaml libffi       # ruby-build recommended
brew install --cask font-ubuntu-mono-derivative-powerline
brew install universal-ctags

asdf plugin add postgres
asdf plugin add python
asdf plugin add ruby https://github.com/asdf-vm/asdf-ruby.git

asdf plugin add nodejs https://github.com/asdf-vm/asdf-nodejs.git
bash ~/.asdf/plugins/nodejs/bin/import-release-team-keyring

# ruby-build doesn't auto-detect Homebrew's keg-only openssl on its own
export RUBY_CONFIGURE_OPTS="--with-openssl-dir=$(brew --prefix openssl)"
asdf install

nvim --headless "+Lazy! sync" +qa

# shipping automation: auto-dev (nightly PR pipeline, hopper, briefs) + the
# morning-feed notification hub. Needs `gh auth login` and claude installed/
# authed first; auto-dev install writes the config + launchd schedules.
# junk-drawer is private, so the tap needs the SSH URL — brew runs git with
# GIT_TERMINAL_PROMPT=0 and can't auth over HTTPS non-interactively.
brew tap liaden/junk-drawer git@github.com:liaden/junk-drawer.git
brew install --HEAD liaden/junk-drawer/auto-dev   # head-only formula; pulls in morning-feed
auto-dev install

# macOS allows only ONE repeating wake; this single 01:58 wake serves the 02:00 nightly
sudo pmset repeat wake MTWRF 01:58:00
