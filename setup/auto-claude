#!/usr/bin/env bash
#
# auto-claude machine setup — wires the tools in ~/bin (hopper, chore-pr,
# rebase-pr, day-brief, ship-digest) to this machine:
#   - ~/.config/auto-claude/config.sh  (machine-local: work repo path, notify)
#   - launchd agents (macOS): rebase-pr weekdays 02:00 (overnight, after West
#     Coast devs stop pushing, so PRs are freshly rebased by morning),
#     critique-pr weekdays 02:30 (right after rebase-pr, so review-requested PRs
#     are critiqued on their freshly-rebased head), chore-pr weekdays 07:00,
#     day-brief weekdays 07:45, ship-digest Friday 15:30
#
# rebase-pr's 02:00 slot needs a scheduled wake — see the pmset note at the
# bottom of this script. critique-pr's 02:30 slot rides the same single wake.
#
# launchd, not cron: launchd runs missed jobs after sleep; cron silently
# skips them. Jobs are scheduled for working hours because a closed-lid
# MacBook runs nothing.
#
# Usage:
#   AUTO_CLAUDE_REPO=~/dev/work-repo ./setup/auto-claude   # or it will prompt
#   ./setup/auto-claude --uninstall
set -euo pipefail

CONF_DIR="$HOME/.config/auto-claude"
AGENT_DIR="$HOME/Library/LaunchAgents"
LOG_DIR="$CONF_DIR/logs"

REBASE_HOUR=2;   REBASE_MIN=0    # overnight, after West Coast devs stop pushing
CRITIQUE_HOUR=2; CRITIQUE_MIN=30 # right after rebase-pr, on freshly-rebased heads
CHORE_HOUR=7;    CHORE_MIN=0
BRIEF_HOUR=7;    BRIEF_MIN=45
DIGEST_HOUR=15;  DIGEST_MIN=30   # Friday

PLIST_IDS="com.auto-claude.chore-pr com.auto-claude.rebase-pr com.auto-claude.critique-pr com.auto-claude.day-brief com.auto-claude.ship-digest"

if [ "${1:-}" = "--uninstall" ]; then
  for id in $PLIST_IDS; do
    plist="$AGENT_DIR/$id.plist"
    launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true
    rm -f "$plist"
  done
  echo "auto-claude unscheduled. Left in place: ~/bin tools and $CONF_DIR."
  exit 0
fi

missing=""
for dep in git gh claude; do
  command -v "$dep" >/dev/null 2>&1 || missing="$missing $dep"
done
[ -z "$missing" ] || { echo "missing:$missing (brew install gh; claude via installer)" >&2; exit 1; }
gh auth status >/dev/null 2>&1 || { echo "run 'gh auth login' first" >&2; exit 1; }

repo="${AUTO_CLAUDE_REPO:-}"
if [ -z "$repo" ]; then
  printf "Path to your work repo: "
  read -r repo
fi
repo="${repo/#\~/$HOME}"
[ -d "$repo/.git" ] || { echo "not a git repo: $repo" >&2; exit 1; }

base_branch="${AUTO_CLAUDE_BASE_BRANCH:-$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')}"
base_branch="${base_branch:-main}"

mkdir -p "$CONF_DIR" "$LOG_DIR" "$CONF_DIR/briefs"
touch "$CONF_DIR/hopper.txt"

cat > "$CONF_DIR/config.sh" <<EOF
# auto-claude config — machine-local, generated by setup/auto-claude. Not tracked.
WORK_REPO="$repo"
BASE_BRANCH="$base_branch"
CONF_DIR="\$HOME/.config/auto-claude"
HOPPER_FILE="\$CONF_DIR/hopper.txt"
BRIEF_DIR="\$CONF_DIR/briefs"
LOG_DIR="\$CONF_DIR/logs"
WORKTREE_DIR="\$CONF_DIR/worktrees"

# Bedrock auth for headless launchd runs. The interactive OAuth login token
# (used when these vars are unset) expires overnight and is unavailable to GUI
# launchd jobs, so pull the long-lived Bedrock bearer token from the login
# keychain instead — same pattern as linear-standup's linear-api key.
#   Key: security add-generic-password -U -s bedrock-api -a "\$USER" -w
export CLAUDE_CODE_USE_BEDROCK=1
AWS_BEARER_TOKEN_BEDROCK="\$(security find-generic-password -s bedrock-api -w 2>/dev/null || true)"
export AWS_BEARER_TOKEN_BEDROCK
if [ -z "\$AWS_BEARER_TOKEN_BEDROCK" ]; then
  echo "no Bedrock token in keychain (service: bedrock-api). Add one with:" >&2
  echo "  security add-generic-password -U -s bedrock-api -a \"\\\$USER\" -w" >&2
fi

# Feed source for notify() below; each job overrides it for correct attribution
# (AUTO_CLAUDE_FEED_SOURCE=day-brief, etc.).
: "\${AUTO_CLAUDE_FEED_SOURCE:=auto-claude}"

notify() {
  # Durable feed entry (also fires the macOS bubble itself).
  notify-feed "\$AUTO_CLAUDE_FEED_SOURCE" "\$1" 2>/dev/null || \\
  if command -v osascript >/dev/null; then
    osascript -e "display notification \"\${1//\"/}\" with title \"auto-claude\"" 2>/dev/null || true
  elif command -v notify-send >/dev/null; then
    notify-send auto-claude "\$1" || true
  fi
}
EOF
echo "wrote $CONF_DIR/config.sh (repo: $repo, base: $base_branch)"

if [[ "$OSTYPE" != darwin* ]]; then
  echo "non-macOS: skipping launchd; schedule chore-pr/day-brief/ship-digest via cron or systemd timers."
  exit 0
fi

# StartCalendarInterval takes no ranges — weekday jobs need one dict per day.
weekday_intervals() { # hour minute
  local h="$1" m="$2" d
  for d in 1 2 3 4 5; do
    printf '    <dict><key>Weekday</key><integer>%s</integer><key>Hour</key><integer>%s</integer><key>Minute</key><integer>%s</integer></dict>\n' "$d" "$h" "$m"
  done
}

write_plist() { # id intervals-xml
  local id="$1" intervals="$2" plist="$AGENT_DIR/$1.plist"
  local tool="${id#com.auto-claude.}"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$id</string>
  <key>ProgramArguments</key>
  <array><string>$HOME/bin/$tool</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/bin:$HOME/.local/bin:$HOME/.bun/bin</string>
    <key>HOME</key><string>$HOME</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
$intervals
  </array>
  <key>StandardOutPath</key><string>$LOG_DIR/$tool.log</string>
  <key>StandardErrorPath</key><string>$LOG_DIR/$tool.log</string>
</dict>
</plist>
PLIST
  launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "scheduled: $id"
}

mkdir -p "$AGENT_DIR"
write_plist com.auto-claude.chore-pr  "$(weekday_intervals $CHORE_HOUR $CHORE_MIN)"
write_plist com.auto-claude.rebase-pr "$(weekday_intervals $REBASE_HOUR $REBASE_MIN)"
write_plist com.auto-claude.critique-pr "$(weekday_intervals $CRITIQUE_HOUR $CRITIQUE_MIN)"
write_plist com.auto-claude.day-brief "$(weekday_intervals $BRIEF_HOUR $BRIEF_MIN)"
write_plist com.auto-claude.ship-digest \
  "$(printf '    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>%s</integer><key>Minute</key><integer>%s</integer></dict>' "$DIGEST_HOUR" "$DIGEST_MIN")"

cat <<DONE

auto-claude wired up. Seed the hopper, then dry-run before trusting the schedule:
  hopper add "bump terraform google provider one minor version"
  day-brief && chore-pr && ship-digest
  rebase-pr --dry-run   # inspect the stack graph + rebase plan before a real run

IMPORTANT — schedule the overnight wake (needs sudo; macOS allows only ONE
repeating wake, so this single 01:58 wake serves the 02:00 rebase-pr job):
  sudo pmset repeat wake MTWRF 01:58:00        # (cancel: sudo pmset repeat cancel)
Reliable on AC power; a lid-closed MacBook on battery may deep-sleep past it.
This replaces any earlier morning wake — chore-pr/day-brief/ship-digest then
run on the next wake (when you open the laptop); launchd runs missed jobs, so
they are not skipped, just deferred to that wake.
DONE
