#!/bin/bash
# Interactive screenshot for the dashboard button.
# First hide the eww dashboard (you almost always want to shoot something else),
# then capture. Prefers flameshot (nicer UX) if installed; otherwise falls back
# to maim region-select into ~/Pictures. For the better experience:
#   sudo apt install flameshot

# Close the overlay so it isn't captured, and let the compositor repaint.
eww close-all 2>/dev/null
sleep 0.25

if command -v flameshot >/dev/null 2>&1; then
  flameshot gui
else
  mkdir -p ~/Pictures
  out=~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
  maim -s "$out" && command -v notify-send >/dev/null 2>&1 && notify-send "Screenshot saved" "$out"
fi
