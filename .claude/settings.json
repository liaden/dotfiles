    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .git)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(chmod -R 777*)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(poweroff*)"
    ]
