#!/usr/bin/env bash
# feed — the single store-ops CLI for the notification-hub spool.
#
# Every read/write of feed.ndjson goes through here so the fragile
# read-modify-write and its portable locking live in exactly one place. Records
# are NDJSON, one per line: {id, ts, source, title, body, meta}. Legacy records
# written before this CLI have no id/meta; every read path tolerates that.
#
# Subcommands:
#   feed add <source> <title> [body] [--meta <json>]
#       Append a record with a generated id (uuidgen), ts, and optional meta
#       object. Body: the positional arg wins; else read from stdin (empty if
#       stdin is a tty). Prints the new id on stdout. Taken under the mutex so it
#       cannot interleave with a concurrent remove's rewrite.
#
#   feed remove <id>
#       Drop the record with this id (jq select → mktemp → atomic mv), under the
#       mutex so a racing add is never lost. Exit 0 whether or not it matched.
#
#   feed query [--source <s>] [--has-meta <key>] [--since-days N] [--json]
#       The shared read path (renderer + picker). Newest-first. Default output is
#       TSV (ts, source, title, body); --json emits a JSON array of full records.
#       --since-days N windows to the last N days (default 3, i.e. today + 2).
#       --has-meta <key> keeps only records whose meta.<key> is present.
#
# Locking: a `mkdir` mutex ($FEED_DIR/.lock) — atomic create, portable (macOS has
# no flock). A trap rmdir's it on exit; a stale lock older than the timeout is
# reclaimed so a dead holder can't wedge the feed forever.
set -euo pipefail

FEED_DIR="$HOME/.local/state/morning-feed"
FEED="$FEED_DIR/feed.ndjson"
LOCK="$FEED_DIR/.lock"
LOCK_TIMEOUT=30   # seconds before a held lock is treated as stale

command -v jq >/dev/null || { echo "feed: jq not found" >&2; exit 1; }

usage() {
  awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"
  exit "${1:-0}"
}

# ── Portable mutex around read-modify-write ──────────────────────────────────
# mkdir is atomic on every filesystem we care about: exactly one racer creates
# the dir, the rest spin. A lock whose mtime is older than LOCK_TIMEOUT is
# assumed abandoned (holder died mid-write) and forcibly reclaimed.
lock_held=0
acquire_lock() {
  mkdir -p "$FEED_DIR"
  local waited=0
  while ! mkdir "$LOCK" 2>/dev/null; do
    local age
    age="$(lock_age)"
    if [ "$age" -ge "$LOCK_TIMEOUT" ]; then
      # Reclaim a stale lock, then retry immediately.
      rmdir "$LOCK" 2>/dev/null || rm -rf "$LOCK" 2>/dev/null || true
      continue
    fi
    sleep 1
    waited=$((waited + 1))
    if [ "$waited" -ge "$LOCK_TIMEOUT" ]; then
      echo "feed: could not acquire lock after ${LOCK_TIMEOUT}s" >&2
      exit 1
    fi
  done
  lock_held=1
  trap release_lock EXIT INT TERM
}

# Age of the current lock dir in whole seconds (0 if it vanished under us).
lock_age() {
  local now mtime
  now="$(date +%s)"
  mtime="$(stat -f %m "$LOCK" 2>/dev/null || stat -c %Y "$LOCK" 2>/dev/null || echo "$now")"
  echo $(( now - mtime ))
}

release_lock() {
  if [ "$lock_held" = 1 ]; then
    rmdir "$LOCK" 2>/dev/null || true
    lock_held=0
  fi
}

# ── add ──────────────────────────────────────────────────────────────────────
cmd_add() {
  local source="" title="" body="" meta="" have_body=0
  local args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --meta) shift; meta="${1:-}" ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  source="${args[0]:-}"
  title="${args[1]:-}"
  if [ "${#args[@]}" -ge 3 ]; then body="${args[2]}"; have_body=1; fi

  if [ -z "$source" ] || [ -z "$title" ]; then
    echo "usage: feed add <source> <title> [body] [--meta <json>]" >&2
    exit 2
  fi

  # Body: positional arg wins; else stdin (unless interactive tty).
  if [ "$have_body" = 0 ]; then
    if [ ! -t 0 ]; then body="$(cat)"; else body=""; fi
  fi

  # Validate --meta up front so a malformed object can't land in the spool.
  if [ -n "$meta" ]; then
    printf '%s' "$meta" | jq -e . >/dev/null 2>&1 || {
      echo "feed: --meta is not valid JSON" >&2; exit 2; }
  fi

  local id
  id="$(uuidgen)"

  acquire_lock
  jq -cn \
    --arg id "$id" \
    --arg ts "$(date '+%Y-%m-%dT%H:%M:%S')" \
    --arg source "$source" \
    --arg title "$title" \
    --arg body "$body" \
    --argjson meta "${meta:-null}" \
    '{id:$id, ts:$ts, source:$source, title:$title, body:$body, meta:$meta}' >> "$FEED"
  release_lock

  printf '%s\n' "$id"
}

# ── remove ─────────────────────────────────────────────────────────────────--
cmd_remove() {
  local id="${1:-}"
  [ -n "$id" ] || { echo "usage: feed remove <id>" >&2; exit 2; }
  acquire_lock
  if [ -f "$FEED" ]; then
    local tmp
    tmp="$(mktemp "$FEED_DIR/feed.XXXXXX")"
    # Keep every record except the one whose id matches. Legacy id-less records
    # have .id == null, which never equals a real uuid, so they survive.
    jq -c --arg id "$id" 'select(.id != $id)' "$FEED" > "$tmp" || {
      rm -f "$tmp"; release_lock; echo "feed: rewrite failed" >&2; exit 1; }
    mv "$tmp" "$FEED"
  fi
  release_lock
}

# ── query ─────────────────────────────────────────────────────────────────--
cmd_query() {
  local filter="" has_meta="" since_days=3 as_json=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --source)     shift; filter="${1:-}" ;;
      --has-meta)   shift; has_meta="${1:-}" ;;
      --since-days) shift; since_days="${1:-3}" ;;
      --json)       as_json=1 ;;
      *) echo "feed query: unknown option $1" >&2; exit 2 ;;
    esac
    shift
  done

  [ -f "$FEED" ] || { [ "$as_json" = 1 ] && echo "[]"; return 0; }

  # Window cutoff: since_days back means (since_days - 1) days ago as a floor,
  # matching the renderer's "today + 2 prior days" for the default of 3.
  local back=$(( since_days - 1 )); [ "$back" -lt 0 ] && back=0
  local cutoff
  cutoff="$(date -v-"${back}"d '+%Y-%m-%d' 2>/dev/null || date -d "${back} days ago" '+%Y-%m-%d')"

  # Shared selection expression: window + optional source + optional meta key.
  local sel='select((.ts[0:10]) >= $cutoff)
    | select($filter == "" or .source == $filter)
    | select($has_meta == "" or (.meta != null and (.meta[$has_meta] != null)))'

  if [ "$as_json" = 1 ]; then
    # Newest-first JSON array of full records.
    jq -c --arg cutoff "$cutoff" --arg filter "$filter" --arg has_meta "$has_meta" \
      "$sel" "$FEED" 2>/dev/null | jq -sc 'reverse'
  else
    # Newest-first TSV (ts, source, title, body) — the renderer's shape.
    jq -r --arg cutoff "$cutoff" --arg filter "$filter" --arg has_meta "$has_meta" \
      "$sel | [.ts, .source, .title, (.body // \"\")] | @tsv" "$FEED" 2>/dev/null \
      | { tail -r 2>/dev/null || tac; }
  fi
}

# ── dispatch ─────────────────────────────────────────────────────────────────
sub="${1:-}"; [ "$#" -gt 0 ] && shift || true
case "$sub" in
  add)    cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  query)  cmd_query "$@" ;;
  -h|--help|"") usage 0 ;;
  *) echo "feed: unknown subcommand '$sub'" >&2; usage 2 ;;
esac
