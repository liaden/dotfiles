#!/usr/bin/env python3
"""herdr-feed-log: append "needs you" and "finished" agent events to the morning feed.

Polls the herdr snapshot because a herdr event subscription needs 1 connection per
pane and drops a connection that subscribes twice.
"""
import json
import subprocess
import sys
import time

POLL_SECONDS = 3
RETRY_SECONDS = 10
TITLES = {"needs-you": "needs you", "finished": "finished"}


def transitions(statuses, snapshot):
    """Return (new statuses by pane id, events) for panes running an agent."""
    snap = snapshot["result"]["snapshot"]
    labels = {w["workspace_id"]: w.get("label") for w in snap.get("workspaces", [])}
    current, events = {}, []
    for pane in snap.get("panes", []):
        if not pane.get("agent"):
            continue
        pane_id, status = pane["pane_id"], pane.get("agent_status")
        current[pane_id] = status
        before = statuses.get(pane_id)
        if before is None or before == status:
            continue
        if status == "blocked":
            kind = "needs-you"
        elif before == "working" and status in ("idle", "done"):
            kind = "finished"
        else:
            continue
        events.append({"event": kind, "pane": pane,
                       "workspace": labels.get(pane["workspace_id"]) or pane["workspace_id"]})
    return current, events


def record(event):
    """Return the feed (title, body, meta) for an event."""
    pane = event["pane"]
    meta = {"event": event["event"], "workspace": event["workspace"],
            "pane": pane["pane_id"], "cwd": pane.get("cwd"), "agent": pane.get("agent")}
    body = (pane.get("tokens") or {}).get("task", "")
    return f"{TITLES[event['event']]}: {event['workspace']}", body, meta


def read_snapshot():
    out = subprocess.run(["herdr", "api", "snapshot"], capture_output=True, text=True,
                         check=True, timeout=10)
    return json.loads(out.stdout)


def poll_once(statuses, last_error, read, add, report):
    """Return (statuses, last error, seconds to wait) after 1 poll."""
    try:
        statuses, events = transitions(statuses, read())
    except (subprocess.SubprocessError, OSError, ValueError, KeyError) as error:
        if str(error) != last_error:
            report(f"herdr-feed-log: {error}")
        return {}, str(error), RETRY_SECONDS
    for event in events:
        add(*record(event))
    return statuses, None, POLL_SECONDS


def add_to_feed(title, body, meta):
    subprocess.run(["feed", "add", "herdr", title, body, "--meta", json.dumps(meta)],
                   capture_output=True, check=False)


def report_error(message):
    print(message, file=sys.stderr, flush=True)


def main():
    statuses, last_error = {}, None
    while True:
        statuses, last_error, wait = poll_once(statuses, last_error, read_snapshot,
                                               add_to_feed, report_error)
        time.sleep(wait)


if __name__ == "__main__":
    main()
