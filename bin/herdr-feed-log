#!/usr/bin/env ruby
# frozen_string_literal: true

# herdr-feed-log: append "needs you" and "finished" agent events to the morning feed.
# Polls the herdr snapshot because a herdr event subscription needs 1 connection per
# pane and drops a connection that subscribes twice.

require "json"
require "open3"

module HerdrFeedLog
  POLL_SECONDS = 3
  RETRY_SECONDS = 10
  TITLES = { "needs-you" => "needs you", "finished" => "finished" }.freeze

  class SnapshotError < StandardError; end

  module_function

  # Returns [statuses by pane id, events] for panes running an agent.
  def transitions(statuses, snapshot)
    snap = snapshot.dig("result", "snapshot")
    labels = snap.fetch("workspaces", []).to_h { |w| [w["workspace_id"], w["label"]] }
    current = {}
    events = []
    snap.fetch("panes", []).each do |pane|
      next unless pane["agent"]

      pane_id, status = pane.values_at("pane_id", "agent_status")
      current[pane_id] = status
      kind = event_kind(statuses[pane_id], status) or next
      events << { event: kind, pane:,
                  workspace: labels[pane["workspace_id"]] || pane["workspace_id"] }
    end
    [current, events]
  end

  def event_kind(before, status)
    return if before.nil? || before == status
    return "needs-you" if status == "blocked"

    # blocked -> idle means it worked and finished between 2 polls
    "finished" if %w[working blocked].include?(before) && %w[idle done].include?(status)
  end

  # Returns the feed [title, body, meta] for an event.
  def record(event)
    pane = event[:pane]
    meta = { event: event[:event], workspace: event[:workspace], pane: pane["pane_id"],
             cwd: pane["cwd"], agent: pane["agent"] }
    title = "#{TITLES.fetch(event[:event])}: #{event[:workspace]}"
    [title, (pane["tokens"] || {}).fetch("task", ""), meta]
  end

  # Returns [statuses, last error, seconds to wait] after 1 poll.
  def poll_once(statuses, last_error, read, add:, report:)
    statuses, events = transitions(statuses, read.call)
    events.each { |event| add.call(*record(event)) }
    [statuses, nil, POLL_SECONDS]
  rescue SnapshotError => e
    report.call("herdr-feed-log: #{e.message}") unless e.message == last_error
    [{}, e.message, RETRY_SECONDS]
  end

  def read_snapshot
    out, err, status = Open3.capture3("herdr", "api", "snapshot")
    raise SnapshotError, snapshot_failure(err, status) unless status.success?

    # systemd passes no LANG, so captured output arrives tagged US-ASCII.
    JSON.parse(out.force_encoding(Encoding::UTF_8))
  rescue JSON::ParserError, SystemCallError => e
    raise SnapshotError, e.message
  end

  def snapshot_failure(err, status)
    err.strip.empty? ? "herdr api snapshot exited #{status.exitstatus}" : err.strip
  end

  def add_to_feed(title, body, meta)
    system("feed", "add", "herdr", title, body, "--meta", JSON.generate(meta),
           out: File::NULL, err: File::NULL)
  end

  def main
    statuses = {}
    last_error = nil
    report = ->(message) { warn message }
    loop do
      statuses, last_error, wait = poll_once(statuses, last_error, method(:read_snapshot),
                                             add: method(:add_to_feed), report:)
      sleep wait
    end
  end
end

HerdrFeedLog.main if $PROGRAM_NAME == __FILE__
