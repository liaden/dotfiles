#!/usr/bin/env bash
#
# pr-rereviews - list the PRs requesting your review, with a deterministic diff
# range for each so a re-review can focus on new code since your last review.
#
# For each open (non-draft) PR in hipphealth/hipp that requests your review:
#   - last_sha = the commit_id of your most recent review on the PR (empty if
#     you have never reviewed it).
#   - head_sha = the PR head commit.
#   - Mode + diff range:
#       no last_sha            -> mode=full          range=<base>...<head>  (first review)
#       last_sha ancestor of   -> mode=rereview      range=<last_sha>..<head_sha>
#         head                                        (only code new since your review)
#       last_sha NOT ancestor  -> mode=full-forcepush range=<base>...<head>  (history was
#         (force-pushed away)                          rewritten; fall back to full diff)
#
# The ancestry guard matters: a force-push can leave your last-review SHA off the
# head's history, so a naive <last_sha>..<head_sha> would be a bogus range. We
# verify with `git merge-base --is-ancestor` and fall back to the full diff.
#
# Pure gh + jq + git; no claude. Runs from $WORK_REPO (needs the checkout for the
# `git fetch` + `merge-base` ancestry check). A single PR's failure is contained
# so it does not abort the sweep. The nightly critique-pr job consumes `-j`.
#
# Requires: gh (authenticated), jq, git, and ~/.config/auto-claude/config.sh
# (for WORK_REPO/BASE_BRANCH). Falls back to CWD + `main` if that is absent.
#
# Usage:
#   pr-rereviews [-u LOGIN] [-r OWNER/REPO] [-j] [-h]
#
#   -u LOGIN      Your GitHub login (default: auto-detected via `gh api user`)
#   -r OWNER/REPO Repository to scan (default: hipphealth/hipp)
#   -j            Emit raw JSON array instead of the formatted table
#   -h            Show this help
set -euo pipefail

REPO="hipphealth/hipp"
ME=""
AS_JSON=0

usage() {
  awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"
  exit "${1:-0}"
}

while getopts ":u:r:jh" opt; do
  case "$opt" in
    u) ME="$OPTARG" ;;
    r) REPO="$OPTARG" ;;
    j) AS_JSON=1 ;;
    h) usage 0 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage 1 ;;
    \?) echo "Unknown option: -$OPTARG" >&2; usage 1 ;;
  esac
done

command -v gh  >/dev/null || { echo "error: gh not found" >&2; exit 1; }
command -v jq  >/dev/null || { echo "error: jq not found" >&2; exit 1; }
command -v git >/dev/null || { echo "error: git not found" >&2; exit 1; }

# Pull WORK_REPO/BASE_BRANCH if the auto-claude config is present; otherwise run
# from the current directory against `main`.
BASE_BRANCH="main"
if [ -f "$HOME/.config/auto-claude/config.sh" ]; then
  # shellcheck disable=SC1090
  . "$HOME/.config/auto-claude/config.sh"
fi
if [ -n "${WORK_REPO:-}" ] && [ -d "$WORK_REPO/.git" ]; then
  cd "$WORK_REPO"
fi

if [ -z "$ME" ]; then
  ME="$(gh api user --jq '.login')"
fi

# Enumerate open, non-draft PRs requesting my review. `gh search prs` does not
# expose headRefName, so we fetch head/base per PR from the pulls API below.
prs_json="$(
  gh search prs --review-requested=@me --state=open --repo "$REPO" \
    --json number,title,url,isDraft \
  | jq -c '[.[] | select(.isDraft == false)]'
)"

numbers="$(printf '%s' "$prs_json" | jq -r '.[].number')"

# Per PR, compute the review scope deterministically. Emit one TSV row that we
# fold back into the PR metadata via jq. A failure on any single PR is logged to
# stderr and skipped, never aborting the sweep.
rows=""  # number<TAB>headRef<TAB>base<TAB>mode<TAB>last_sha<TAB>head_sha<TAB>diff_range
while IFS= read -r n; do
  [ -z "$n" ] && continue
  if ! pr="$(gh api "repos/$REPO/pulls/$n" \
      --jq '{head:.head.sha, headRef:.head.ref, baseRef:.base.ref}' 2>/dev/null)"; then
    echo "pr-rereviews: WARN could not read PR #$n; skipping" >&2
    continue
  fi
  head_sha="$(printf '%s' "$pr" | jq -r '.head')"
  head_ref="$(printf '%s' "$pr" | jq -r '.headRef')"
  base_ref="$(printf '%s' "$pr" | jq -r '.baseRef')"

  # Most recent review by me on this PR (empty if I have never reviewed it).
  last_sha="$(gh api "repos/$REPO/pulls/$n/reviews" --paginate \
    --jq "[.[] | select(.user.login==\"$ME\")] | .[-1].commit_id // empty" 2>/dev/null || true)"

  mode="full"
  diff_range="origin/$base_ref...$head_sha"

  if [ -n "$last_sha" ]; then
    # Need both SHAs locally to test ancestry. Fetch quietly; a fetch miss just
    # falls through to the non-ancestor (safe, full-diff) branch below.
    git fetch --quiet origin "$last_sha" "$head_sha" 2>/dev/null || \
      git fetch --quiet origin "$head_ref" "$base_ref" 2>/dev/null || true
    if git merge-base --is-ancestor "$last_sha" "$head_sha" 2>/dev/null; then
      mode="rereview"
      diff_range="$last_sha..$head_sha"
    else
      mode="full-forcepush"
      diff_range="origin/$base_ref...$head_sha"
    fi
  fi

  rows+="${n}	${head_ref}	${base_ref}	${mode}	${last_sha}	${head_sha}	${diff_range}"$'\n'
done <<< "$numbers"

# Merge the computed scope back into the PR metadata (title/url from the search).
merged="$(
  printf '%s' "$prs_json" | jq \
    --rawfile raw <(printf '%s' "$rows") '
    ($raw | rtrimstr("\n") | split("\n")
      | map(select(length > 0) | split("\t")
        | {number:(.[0]|tonumber), headRefName:.[1], baseRefName:.[2],
           mode:.[3], last_sha:.[4], head_sha:.[5], diff_range:.[6]})
      | INDEX(.number|tostring)) as $scope
    | map(. + ($scope[.number|tostring] // {}))
    | map(select(has("mode")))   # drop PRs we could not scope
    | map({number, title, url, headRefName, mode, last_sha, head_sha, diff_range})
    | sort_by(.number)
  '
)"

if [ "$AS_JSON" == "1" ]; then
  printf '%s\n' "$merged"
  exit 0
fi

count="$(printf '%s' "$merged" | jq 'length')"
echo "PRs requesting review by ${ME} in ${REPO}: ${count}"
echo

printf '%s' "$merged" | jq -r '
  .[] | "#\(.number)\t\(.mode)\t\(.diff_range)\t\(.title)"
' | column -t -s $'\t'
