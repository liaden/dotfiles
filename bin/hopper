#!/usr/bin/env bash
# hopper — capture chores the moment you notice them, without switching tasks.
# chore-pr consumes the top item on a schedule. See setup/auto-claude.
set -euo pipefail
. "$HOME/.config/auto-claude/config.sh"

cmd="${1:-list}"
[ $# -gt 0 ] && shift

drop_line() { # line-number
  local tmp
  tmp="$(mktemp)"
  awk -v n="$1" 'NR != n' "$HOPPER_FILE" > "$tmp"
  mv "$tmp" "$HOPPER_FILE"
}

case "$cmd" in
  add)
    [ $# -gt 0 ] || { echo "usage: hopper add <one-line chore description>" >&2; exit 1; }
    printf '%s\n' "$*" >> "$HOPPER_FILE"
    echo "queued: $*"
    ;;
  list)
    if [ -s "$HOPPER_FILE" ]; then nl -ba "$HOPPER_FILE"; else echo "(hopper empty)"; fi
    ;;
  pop)
    [ -s "$HOPPER_FILE" ] || { echo "(hopper empty)" >&2; exit 1; }
    head -n 1 "$HOPPER_FILE"
    drop_line 1
    ;;
  rm)
    [ $# -eq 1 ] || { echo "usage: hopper rm <line-number>" >&2; exit 1; }
    drop_line "$1"
    ;;
  edit)
    "${EDITOR:-vi}" "$HOPPER_FILE"
    ;;
  *)
    echo "usage: hopper add <text> | list | pop | rm <n> | edit" >&2
    exit 1
    ;;
esac
