#!/usr/bin/env bash
# notify-feed — the universal write path into the notification hub.
#
# Usage: notify-feed <source> <title> [body]
#   If [body] is omitted, it is read from stdin (empty if stdin is a tty).
#
# Thin wrapper over `feed add` (which owns the record shape, id generation, and
# the portable mkdir-lock), plus the macOS notification bubble so behaviour for
# non-pane-watchers is preserved. Kept as a stable entry point so every existing
# producer (rebase-pr, chore-pr, day-brief, …) keeps working unchanged; records
# now carry an id via `feed add`. Pure file + notification: no auth/keychain/
# claude, so it works from the bare-env launchd jobs and any future adapter.
set -euo pipefail

source="${1:-}"
title="${2:-}"
if [ -z "$source" ] || [ -z "$title" ]; then
  echo "usage: notify-feed <source> <title> [body]" >&2
  exit 2
fi

# Body: third arg wins; otherwise read stdin (unless it's an interactive tty).
if [ "$#" -ge 3 ]; then
  body="$3"
elif [ ! -t 0 ]; then
  body="$(cat)"
else
  body=""
fi

# Append via the store-ops CLI (generates id, ts; takes the mutex). `feed` is on
# PATH beside this script; fall back to a sibling path if PATH is bare (minimal
# launchd env).
FEED_BIN="$(command -v feed || echo "$(dirname "$0")/feed")"
"$FEED_BIN" add "$source" "$title" "$body" >/dev/null

# Fire the macOS bubble too (best-effort; never fail the write on this).
if command -v osascript >/dev/null 2>&1; then
  osascript -e "display notification \"${title//\"/}\" with title \"${source//\"/}\"" 2>/dev/null || true
elif command -v notify-send >/dev/null 2>&1; then
  notify-send "$source" "$title" || true
fi
