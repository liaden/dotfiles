#!/usr/bin/env ruby
# frozen_string_literal: true

# herdr-pr-watch: for each parked herdr workspace, check its pull request with gh.
# Shows the PR state on the workspace, logs changes to the morning feed, and raises a
# herdr notification when a change needs you. Run by a systemd timer.

require "fileutils"
require "json"
require "open3"

module HerdrPrWatch
  STATE_FILE = File.join(Dir.home, ".local/state/herdr-pr-watch/state.json")
  PR_FIELDS = "number,state,reviewDecision,url,statusCheckRollup,latestReviews"
  FAILED = %w[FAILURE TIMED_OUT CANCELLED ACTION_REQUIRED STARTUP_FAILURE ERROR].freeze
  CLOSED = %w[MERGED CLOSED].freeze
  DECIDED = %w[APPROVED CHANGES_REQUESTED].freeze
  REVIEW_TEXT = { "APPROVED" => "approved", "CHANGES_REQUESTED" => "changes requested",
                  "REVIEW_REQUIRED" => "awaiting review" }.freeze

  module_function

  def parked_workspaces(snapshot)
    snap = snapshot.dig("result", "snapshot")
    folders = {}
    snap.fetch("panes", []).each do |pane|
      folders[pane["workspace_id"]] ||= pane["foreground_cwd"] || pane["cwd"]
    end
    snap.fetch("workspaces", []).filter_map do |workspace|
      note = workspace.dig("tokens", "parked")
      cwd = folders[workspace["workspace_id"]]
      next if note.to_s.empty? || cwd.nil?

      { id: workspace["workspace_id"], label: workspace["label"] || workspace["workspace_id"],
        cwd:, note: }
    end
  end

  def ci_state(checks)
    return "none" if checks.empty?

    outcomes = checks.map do |check|
      check["conclusion"].to_s.empty? ? check["state"].to_s : check["conclusion"]
    end
    return "failed" if outcomes.intersect?(FAILED)

    running = checks.any? do |check|
      (check["status"] && check["status"] != "COMPLETED") || %w[PENDING
                                                                EXPECTED].include?(check["state"])
    end
    running ? "running" : "passed"
  end

  def summarize(pr)
    { number: pr["number"], state: pr["state"], url: pr["url"], review: pr["reviewDecision"].to_s,
      reviews: Array(pr["latestReviews"]).size, ci: ci_state(Array(pr["statusCheckRollup"])) }
  end

  # Returns [[text, needs you?]] for what changed between 2 summaries.
  def changes(before, after)
    return [] if before.nil?

    [state_change(before, after), review_change(before, after), ci_change(before, after)].compact
  end

  def state_change(before, after)
    return unless after[:state] != before[:state] && CLOSED.include?(after[:state])

    [after[:state].downcase,
     false]
  end

  def review_change(before, after)
    if after[:review] != before[:review] && DECIDED.include?(after[:review])
      [REVIEW_TEXT.fetch(after[:review]), true]
    elsif after[:reviews] > before[:reviews]
      ["new review", true]
    end
  end

  def ci_change(before, after)
    return if after[:ci] == before[:ci] || !%w[failed passed].include?(after[:ci])

    ["CI #{after[:ci]}", after[:ci] == "failed"]
  end

  def token(summary)
    parts = if CLOSED.include?(summary[:state])
              [summary[:state].downcase]
            else
              [REVIEW_TEXT[summary[:review]], ("CI #{summary[:ci]}" unless summary[:ci] == "none")]
            end
    text = parts.compact.join(", ")
    text.empty? ? "PR ##{summary[:number]}" : "PR ##{summary[:number]}: #{text}"
  end

  # Returns [new state by folder, actions] for the parked workspaces.
  def plan(snapshot, state, fetch)
    new_state = {}
    actions = []
    parked_workspaces(snapshot).each do |workspace|
      pr = fetch.call(workspace[:cwd]) or next
      summary = summarize(pr)
      new_state[workspace[:cwd]] = summary
      actions << { kind: :token, workspace: workspace[:id], text: token(summary) }
      changes(state[workspace[:cwd]], summary).each do |text, needs_you|
        actions.concat(change_actions(workspace, summary, "#{workspace[:label]}: #{text}",
                                      needs_you))
      end
    end
    [new_state, actions]
  end

  def change_actions(workspace, summary, title, needs_you)
    meta = { event: "pr", workspace: workspace[:label], cwd: workspace[:cwd], url: summary[:url] }
    feed = { kind: :feed, title:, body: workspace[:note], meta: }
    needs_you ? [feed, { kind: :notify, title:, body: summary[:url] }] : [feed]
  end

  def load_state(raw) = raw.transform_values { |summary| summary.transform_keys(&:to_sym) }

  # systemd passes no LANG, so captured output arrives tagged US-ASCII.
  def capture_json(*command, **)
    out, _err, status = Open3.capture3(*command, **)
    JSON.parse(out.force_encoding(Encoding::UTF_8)) if status.success?
  rescue JSON::ParserError, SystemCallError
    nil
  end

  def fetch_pr(cwd) = capture_json("gh", "pr", "view", "--json", PR_FIELDS, chdir: cwd)

  def command_for(action)
    case action[:kind]
    when :token
      ["herdr", "workspace", "report-metadata", action[:workspace], "--source", "herdr-pr-watch",
       "--token", "pr=#{action[:text]}"]
    when :feed
      ["feed", "add", "herdr", action[:title], action[:body], "--meta",
       JSON.generate(action[:meta])]
    else
      ["herdr", "notification", "show", action[:title], "--body", action[:body]]
    end
  end

  def saved_state
    load_state(JSON.parse(File.read(STATE_FILE)))
  rescue SystemCallError, JSON::ParserError
    {}
  end

  def main
    snapshot = capture_json("herdr", "api", "snapshot") or return
    new_state, actions = plan(snapshot, saved_state, method(:fetch_pr))
    actions.each { |action| system(*command_for(action), out: File::NULL, err: File::NULL) }
    FileUtils.mkdir_p(File.dirname(STATE_FILE))
    File.write(STATE_FILE, JSON.generate(new_state))
  end
end

HerdrPrWatch.main if $PROGRAM_NAME == __FILE__
