#!/usr/bin/env bash
# nightly-coordinator — the single overnight auto-claude entry point. Holds ONE
# caffeinate for the whole night and runs the three PR jobs SEQUENTIALLY, so they
# never contend on the shared ~/dev/hipp/.git (previously rebase-pr at 02:00 could
# overrun into critique-pr at 02:30 and chore-pr at 07:00, racing on worktree/
# fetch/ref locks). Replaces the three separate launchd schedules with one.
#
# Stages, in order (each isolated: a failure is recorded and the next stage still
# runs):
#   1. rebase-pr  — freshen my open PRs (rebase onto base, fix breakage, push).
#   2. critique-pr — critique PRs requesting my review, on their freshly-rebased
#                    heads → one feed item per PR.
#   3. chore-pr   — drain the hopper into draft PRs (loop until empty or a
#                    per-run cap), moved here from its old 07:00 slot so new PRs
#                    are ready by morning.
#
# Each stage is a normal ~/bin job; run standalone they each grab their own
# caffeinate, but here AUTO_CLAUDE_CAFFEINATED=1 (exported by our guard) makes
# their guards no-op so only THIS process holds caffeinate.
#
# Scheduled by ~/setup/auto-claude as com.auto-claude.nightly at 02:00 weekdays,
# served by the single 01:58 pmset wake. day-brief (07:45) then summarizes the
# PRs this run produced.
#
# Usage:
#   nightly-coordinator                # real run: all three stages
#   nightly-coordinator --only rebase  # run one stage (rebase|critique|chore)
#   nightly-coordinator --dry-run      # print the plan; no jobs run
set -euo pipefail

# Shared harness first (owns the caffeinate coordination + perm posture).
. "$(dirname "$0")/lib/auto-claude-job.sh"

# One caffeinate for the whole night; exports AUTO_CLAUDE_CAFFEINATED=1 so each
# stage's own guard no-ops.
ac_caffeinate_guard nightly-coordinator "$@"

AUTO_CLAUDE_FEED_SOURCE=nightly
. "$HOME/.config/auto-claude/config.sh"

BIN="$(dirname "$0")"
CHORE_MAX="${NIGHTLY_CHORE_MAX:-5}"   # safety cap on hopper items drained per night

ONLY=""
DRY_RUN=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --only) shift; ONLY="${1:-}" ;;
    --dry-run) DRY_RUN=true ;;
    --help|-h) awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

want() { [ -z "$ONLY" ] || [ "$ONLY" = "$1" ]; }

if [ "$DRY_RUN" = true ]; then
  echo "nightly-coordinator plan (single caffeinate, sequential):"
  want rebase   && echo "  1. rebase-pr"
  want critique && echo "  2. critique-pr"
  want chore    && echo "  3. chore-pr (drain hopper, up to $CHORE_MAX items)"
  echo "(dry run — no jobs run)"
  exit 0
fi

echo "=== $(date '+%F %T') nightly-coordinator start ==="
results=()   # "stage: outcome"
failed=0

# Run a stage, capturing its exit without aborting the coordinator.
run_stage() { # label command...
  local label="$1"; shift
  echo "--- $(date '+%F %T') stage: $label ---"
  set +e
  "$@"
  local rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then
    results+=("$label: ok")
  else
    results+=("$label: FAILED (rc=$rc)")
    failed=1
  fi
  return 0
}

# Stage 1 — rebase.
if want rebase; then
  run_stage rebase-pr "$BIN/rebase-pr"
fi

# Stage 2 — critique.
if want critique; then
  run_stage critique-pr "$BIN/critique-pr"
fi

# Stage 3 — chore, drained. chore-pr processes ONE hopper item per invocation and
# exits 0 on empty; loop until the hopper is empty or we hit the per-night cap.
if want chore; then
  drained=0
  prev_top=""
  while [ "$drained" -lt "$CHORE_MAX" ]; do
    # Empty hopper → nothing left to drain.
    [ -s "$HOPPER_FILE" ] || break
    # Guard against spinning on a stuck item: if the top item is unchanged from
    # the previous iteration (a failure left it queued), stop draining.
    cur_top="$(head -n1 "$HOPPER_FILE" 2>/dev/null || true)"
    if [ -n "$prev_top" ] && [ "$cur_top" = "$prev_top" ]; then
      results+=("chore-pr: stopped (top item did not clear)")
      break
    fi
    prev_top="$cur_top"
    run_stage "chore-pr[$((drained + 1))]" "$BIN/chore-pr"
    drained=$((drained + 1))
  done
  [ "$drained" -eq 0 ] && results+=("chore-pr: hopper empty")
fi

# ── Summary ──────────────────────────────────────────────────────────────────
echo "=== $(date '+%F %T') nightly-coordinator done ==="
printf '  %s\n' "${results[@]}"

body="$(printf '%s\n' "${results[@]}")"
title="nightly: $([ "$failed" -eq 0 ] && echo 'all stages ok' || echo 'a stage needs a human')"
notify-feed nightly "$title" "$body"

# Non-zero exit if any stage failed, so a launchd failure surfaces.
[ "$failed" -eq 0 ]
