#!/usr/bin/env bash
# gh-review-watch — near-real-time GitHub review-request adapter for the feed.
#
# Polls for PRs where a review is requested from me, dedups against a seen-set
# of PR URLs, and pushes a feed entry only for newly-appeared requests. `gh` is
# already authenticated (day-brief/ship-digest use it) — no new credentials.
#
# Scheduled via ~/Library/LaunchAgents/com.morning-feed.gh-review-watch.plist.
set -uo pipefail

SEEN="$HOME/.local/state/morning-feed/gh-seen.txt"
mkdir -p "$(dirname "$SEEN")"
touch "$SEEN"

prs="$(gh search prs --review-requested "@me" --state open \
        --json title,url,repository 2>/dev/null || echo '[]')"

# Iterate current open review requests. Each line: url<TAB>title<TAB>repo
while IFS=$'\t' read -r url title repo; do
  [ -z "$url" ] && continue
  if ! grep -qxF "$url" "$SEEN"; then
    notify-feed github "Review requested: $title" "$repo — $url"
    echo "$url" >> "$SEEN"
  fi
done < <(jq -r '.[] | [.url, .title, .repository.nameWithOwner] | @tsv' <<<"$prs")
