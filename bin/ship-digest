#!/usr/bin/env bash
# ship-digest — Friday "shipped this week" evidence stream, straight to the
# clipboard. Counter-evidence for "doesn't ship enough" is half perception;
# this generates it while you do something else.
set -euo pipefail
AUTO_CLAUDE_FEED_SOURCE=ship-digest
. "$HOME/.config/auto-claude/config.sh"

cd "$WORK_REPO"
since="$(date -v-6d +%F 2>/dev/null || date -d '6 days ago' +%F)"
out="$BRIEF_DIR/digest-$(date +%F).md"

merged="$(gh search prs --author "@me" --merged --merged-at ">=$since" \
          --json title,url,repository 2>/dev/null || echo '[]')"
reviewed="$(gh search prs --reviewed-by "@me" --updated ">=$since" \
          --json title,url,repository 2>/dev/null || echo '[]')"
inflight="$(gh pr list --author "@me" --state open \
          --json title,url,isDraft 2>/dev/null || echo '[]')"

clip() {
  if command -v pbcopy >/dev/null; then pbcopy
  elif command -v xclip >/dev/null; then xclip -selection clipboard
  else cat >/dev/null
  fi
}

claude -p "Format a short weekly update for my manager from this GitHub data
(week starting $since). Markdown, plain confident tone, no fluff, no
self-deprecation. Sections, each item one line: Shipped (merged PRs),
Reviews, In flight. Skip empty sections. Exclude my own PRs from Reviews.

Merged: $merged
Reviewed: $reviewed
In flight: $inflight" | tee "$out" | clip

notify-feed ship-digest "Weekly digest (on clipboard)" "$(cat "$out")"
