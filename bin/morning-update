#!/usr/bin/env bash
# morning-update — keep the toolbox current before the day's work.
#   - Homebrew: refresh formula metadata, then upgrade outdated packages.
#     No `cleanup`: keep old versions on disk as a fallback if an upgrade
#     misbehaves.
#   - zgenom: pull latest for all plugins. `zgenom` is a zsh function, not a
#     binary, so it must run inside zsh with zgenom.zsh sourced — it can't be
#     exec'd directly from launchd.
# Scheduled daily via ~/Library/LaunchAgents/com.morning.update.plist.
set -uo pipefail   # not -e: one failing step shouldn't skip the rest

LOG_DIR="$HOME/.config/morning-update/logs"
mkdir -p "$LOG_DIR"

echo "=== $(date '+%F %T') morning-update start"

brew_summary="brew skipped"
if command -v brew >/dev/null 2>&1; then
  echo "--- brew update"
  brew update || echo "brew update failed (continuing)"
  echo "--- brew upgrade"
  # Count upgraded packages from the upgrade output for the feed summary.
  upgraded="$(brew upgrade 2>&1 | tee /dev/stderr | grep -c '^==> Upgrading' || true)"
  brew_summary="brew upgraded ${upgraded:-0}"
else
  echo "brew not found; skipping"
fi

zgenom_summary="zgenom skipped"
if [ -r "$HOME/.zgenom/zgenom.zsh" ]; then
  echo "--- zgenom update"
  if zsh -c 'source "$HOME/.zgenom/zgenom.zsh"; zgenom update'; then
    zgenom_summary="zgenom updated"
  else
    echo "zgenom update failed (continuing)"
    zgenom_summary="zgenom update failed"
  fi
else
  echo "zgenom not found; skipping"
fi

echo "=== $(date '+%F %T') morning-update done"
notify-feed morning-update "Toolbox updated" "$brew_summary; $zgenom_summary"
