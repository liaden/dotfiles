#!/usr/bin/env ruby

require "set"

SIDEBAR=%w[
  sidebar
]

DASHBOARD=%w[
  dashboard
]

WINDOW_LIST={
  dashboard: DASHBOARD,
  sidebar: SIDEBAR,
}

def eww_windows
  result = { open: [], closed: [] }

  # eww >= 0.2 renamed `eww windows`: open windows come from `active-windows`
  # (formatted "name: name"), all defined windows from `list-windows`.
  open = `eww active-windows`.lines.map { |l| l.split(":").first.to_s.strip }.reject(&:empty?)

  `eww list-windows`.split.each do |window|
    (open.include?(window) ? result[:open] : result[:closed]) << window
  end

  result
end

def eww_open(*windows)
  `eww open-many #{windows.flatten.join(' ')}`
end

# closes all windows that are listed.
# close-all closes everything that is open :(
def eww_close(*windows)
  windows.each do |window|
    `eww close #{window}`
  end
end

# toggles windows open and close
# if anything is open, it just closes
def eww_toggle(*windows)
  state = eww_windows

  windows = windows.flatten
  if windows.to_set.intersection(state[:open]).any?
    eww_close(*windows)
  else
    eww_open(*windows)
  end
end

def window_list_arg
  if ARGV.empty?
    STDERR.puts "Must specify a window list: #{WINDOW_LIST.keys.join(" ")}"
    exit 1
  end

  name = ARGV[0].to_sym
  WINDOW_LIST[name].tap do |result|
    if result.empty?
      STDERR.puts "Unknown window list name: #{name}"
      STDERR.puts "Valid choices: #{WINDOW_LIST.keys.join(" ")}"
      exit 1
    end
  end
end

group = ARGV[0]
windows = window_list_arg

case ARGV[1] || "toggle"
when "toggle" then eww_toggle(windows)
when "open"   then eww_open(windows)
when "close"  then eww_close(*windows)
else
  STDERR.puts "Unknown action: #{ARGV[1]}"
  STDERR.puts "Valid choices: toggle open close"
  exit 1
end

# Reflect the new open-state so eww's `:run-while <group>-open` polls
# (volume/brightness) only run while that group is visible.
now_open = eww_windows[:open]
is_open = windows.any? { |w| now_open.include?(w) }
`eww update #{group}-open=#{is_open}`
