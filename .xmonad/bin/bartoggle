#!/bin/bash
# Usage: bartoggle [show|hide]; no argument toggles.
# Output goes to /dev/null so the panels never hold a caller's pipe open.
exec >/dev/null 2>&1

show() {
    pgrep -x tint2 && return
    for rc in panellauncher clock customscripts icons workspaces; do
        tint2 -c ~/.config/tint2/$rc.tint2rc &
    done
}

case "${1:-toggle}" in
    show) show ;;
    hide) pkill -x tint2 ;;
    toggle) pkill -x tint2 || show ;;
    *) exit 2 ;;
esac
